{
  "name": "LockedIn",
  "description": "Production extension for DandyHacks '25",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "idle",
    "scripting",
    "tabs",
    "storage",
    "activeTab"
  ],

  "background": {},

  "action": {
    "default_icon": "assets/lockedin_icon.png",
    "default_popup": "main/sidebar_main.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "assets/lockedin_icon.png",
        "assets/lockedin_logo.png",
        "main/sidebar_main.html",
        "friends/sidebar_friends.html",
        "main/sidebar_main.css",
        "friends/sidebar_friends.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}