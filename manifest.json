{
  "manifest_version": 3,
  "name": "LockedIn Sidebar",
  "version": "1.0",
  "description": "Productivity sidebar extension",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "assets/lockedin_logo.png",
      "48": "assets/lockedin_logo.png",
      "128": "assets/lockedin_logo.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject_sidebar.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "main/sidebar_main.html",
        "main/sidebar_main.css",
        "main/sidebar_main.js",
        "friends/sidebar_friends.html",
        "friends/sidebar_friends.css",
        "friends/sidebar_friends.js",
        "assets/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}