
{
  "name": "LockedIn",
  "description": "Production extension for DandyHacks '25",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": ["idle", "scripting", "tabs", "sidePanel"],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_icon": "assets/extension_dropdown.png",
    "openFriends": "friends/sidebar_friends.html",
    "openLockedIn": "main/sidebar_main.html"
  },
  "side_panel": {
    "default_path": "main/sidebar_main.html"
  }
}
