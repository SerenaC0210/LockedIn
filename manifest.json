{
  "manifest_version": 3,
  "name": "LockedIn",
  "version": "1.0",
  "description": "Production extension for DandyHacks '25",

  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "permissions": [
    "idle",
    "scripting",
    "tabs",
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_icon": "assets/lockedin_icon.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "eleven.js",
        "idle.js",
        "scripts/content.js",
        "inject_sidebar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "musicFun.mp3",
        "scream.mp3",
        "main/sidebar_main.html",
        "main/sidebar_main.css",
        "main/sidebar_main.js",
        "friends/sidebar_friends.html",
        "friends/sidebar_friends.css",
        "friends/sidebar_friends.js",
        "assets/*"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
